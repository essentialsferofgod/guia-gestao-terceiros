# Copie para .env somente se quiser alterar algum valor. Nenhum destes valores é um segredo real.
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_PATH=data/app.db
MEDIA_DIR=media
# Use true somente com HTTPS.
COOKIE_SECURE=false
SESSION_TTL_HOURS=168
TRIAL_DAYS=14
MAX_UPLOAD_MB=300
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300
# Senha das contas demonstrativas criadas no primeiro início.
DEMO_PASSWORD=Demo@2026
SEED_ON_START=true
